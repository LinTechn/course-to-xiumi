{"config":{"indexing":"full","lang":["en"],"min_search_length":3,"prebuild_index":false,"separator":"[\\s\\-]+"},"docs":[{"location":"","text":"\u6559\u7a0b\u8bf4\u660e \u516c\u4f17\u53f7\u5e73\u53f0\u662f\u5404\u515a\u653f\u673a\u5173\u3001\u9ad8\u6821\u7ec4\u7ec7\u3001\u4e8b\u4e1a\u5355\u4f4d\u7b49\u5e38\u7528\u7684\u5ba3\u4f20\u6e20\u9053\uff0c\u63a8\u6587\u5219\u662f\u516c\u4f17\u53f7\u5e73\u53f0\u4e2d\u5185\u5bb9\u7684\u4e3b\u8981\u5f62\u5f0f\u3002 \u79c0\u7c73 \uff0c\u662f\u4e00\u6b3e\u4e13\u6ce8\u4e8e\u5fae\u4fe1\u516c\u4f17\u53f7\u6587\u7ae0\u6392\u7248\u7684\u5728\u7ebf\u7f16\u8f91\u5de5\u5177\uff0c\u63d0\u4f9b\u4e30\u5bcc\u7684\u6a21\u677f\u3001\u6837\u5f0f\u548c\u6392\u7248\u529f\u80fd\uff0c\u5e2e\u52a9\u7528\u6237\u5feb\u901f\u5236\u4f5c\u51fa\u7f8e\u89c2\u3001\u4e13\u4e1a\u7684\u56fe\u6587\u5185\u5bb9\uff0c\u5e7f\u6cdb\u5e94\u7528\u4e8e\u65b0\u5a92\u4f53\u8fd0\u8425\u3001\u5185\u5bb9\u521b\u4f5c\u7b49\u9886\u57df\u3002\u5b66\u4f1a\u4f7f\u7528\u79c0\u7c73\u8fdb\u884c\u6392\u7248\u80fd\u591f\u6781\u5927\u5730\u63d0\u5347\u63a8\u6587\u7684\u7f8e\u89c2\u7a0b\u5ea6\u548c\u5236\u4f5c\u6548\u7387\uff0c\u8fd9\u4e5f\u5c31\u662f\u672c\u6559\u7a0b\u4e4b\u6240\u4ee5\u5b58\u5728\u7684\u539f\u56e0\u3002 \u672c\u6559\u7a0b\u7684\u6838\u5fc3\u76ee\u7684\u6709\u4e24\u4e2a\uff1a \u8ba9\u539f\u672c\u5b8c\u5168\u4e0d\u4f1a\u6392\u7248\u7684\u5feb\u901f\u4e0a\u624b\u6392\u7248\uff1b \u9ad8\u6548\u3001\u51c6\u786e\u5730\u6ee1\u8db3\u8fdb\u9636\u7684\u5b66\u4e60\u9700\u6c42\u3002 \u8fd9\u4e5f\u5c31\u81ea\u7136\u5730\u5c06\u672c\u6559\u7a0b\u5206\u4e3a\u4e86\u4e24\u4e2a\u5927\u7684\u90e8\u5206\uff0c\u5373\u5165\u95e8\u7bc7\u548c\u8fdb\u9636\u7bc7\u3002 \u5165\u95e8\u7bc7\u7531\u5e8f\u4e0e\u7b2c\u4e00\u7ae0\u6784\u6210\u3002 \u8fdb\u9636\u7bc7\u7531\u7b2c\u4e8c\u7ae0\u53ca\u4ee5\u540e\u7684\u90e8\u5206\u6784\u6210\u3002","title":"\u6559\u7a0b\u7b80\u4ecb"},{"location":"#_1","text":"\u516c\u4f17\u53f7\u5e73\u53f0\u662f\u5404\u515a\u653f\u673a\u5173\u3001\u9ad8\u6821\u7ec4\u7ec7\u3001\u4e8b\u4e1a\u5355\u4f4d\u7b49\u5e38\u7528\u7684\u5ba3\u4f20\u6e20\u9053\uff0c\u63a8\u6587\u5219\u662f\u516c\u4f17\u53f7\u5e73\u53f0\u4e2d\u5185\u5bb9\u7684\u4e3b\u8981\u5f62\u5f0f\u3002 \u79c0\u7c73 \uff0c\u662f\u4e00\u6b3e\u4e13\u6ce8\u4e8e\u5fae\u4fe1\u516c\u4f17\u53f7\u6587\u7ae0\u6392\u7248\u7684\u5728\u7ebf\u7f16\u8f91\u5de5\u5177\uff0c\u63d0\u4f9b\u4e30\u5bcc\u7684\u6a21\u677f\u3001\u6837\u5f0f\u548c\u6392\u7248\u529f\u80fd\uff0c\u5e2e\u52a9\u7528\u6237\u5feb\u901f\u5236\u4f5c\u51fa\u7f8e\u89c2\u3001\u4e13\u4e1a\u7684\u56fe\u6587\u5185\u5bb9\uff0c\u5e7f\u6cdb\u5e94\u7528\u4e8e\u65b0\u5a92\u4f53\u8fd0\u8425\u3001\u5185\u5bb9\u521b\u4f5c\u7b49\u9886\u57df\u3002\u5b66\u4f1a\u4f7f\u7528\u79c0\u7c73\u8fdb\u884c\u6392\u7248\u80fd\u591f\u6781\u5927\u5730\u63d0\u5347\u63a8\u6587\u7684\u7f8e\u89c2\u7a0b\u5ea6\u548c\u5236\u4f5c\u6548\u7387\uff0c\u8fd9\u4e5f\u5c31\u662f\u672c\u6559\u7a0b\u4e4b\u6240\u4ee5\u5b58\u5728\u7684\u539f\u56e0\u3002 \u672c\u6559\u7a0b\u7684\u6838\u5fc3\u76ee\u7684\u6709\u4e24\u4e2a\uff1a \u8ba9\u539f\u672c\u5b8c\u5168\u4e0d\u4f1a\u6392\u7248\u7684\u5feb\u901f\u4e0a\u624b\u6392\u7248\uff1b \u9ad8\u6548\u3001\u51c6\u786e\u5730\u6ee1\u8db3\u8fdb\u9636\u7684\u5b66\u4e60\u9700\u6c42\u3002 \u8fd9\u4e5f\u5c31\u81ea\u7136\u5730\u5c06\u672c\u6559\u7a0b\u5206\u4e3a\u4e86\u4e24\u4e2a\u5927\u7684\u90e8\u5206\uff0c\u5373\u5165\u95e8\u7bc7\u548c\u8fdb\u9636\u7bc7\u3002 \u5165\u95e8\u7bc7\u7531\u5e8f\u4e0e\u7b2c\u4e00\u7ae0\u6784\u6210\u3002 \u8fdb\u9636\u7bc7\u7531\u7b2c\u4e8c\u7ae0\u53ca\u4ee5\u540e\u7684\u90e8\u5206\u6784\u6210\u3002","title":"\u6559\u7a0b\u8bf4\u660e"},{"location":"chapter0/","text":"\u5e8f\uff1a\u8ba4\u8bc6\u754c\u9762 \u79c0\u7c73\u4e3b\u9875 \u5728\u767b\u5f55\u6216\u6ce8\u518c\u540e\uff0c\u6211\u4eec\u4f1a\u8df3\u8f6c\u5230\u79c0\u7c73\u7684\u4e3b\u9875\uff08\u89c1\u4e0b\u56fe\uff09\u3002\u70b9\u51fb\u5de6\u4e0a\u65b9\u7684 \u6211\u7684\u79c0\u7c73 \uff0c\u8fdb\u5165\u4e2a\u4eba\u4e3b\u9875\u4ece\u800c\u7ee7\u7eed\u5176\u4ed6\u64cd\u4f5c","title":"\u5e8f\u8a00\uff1a\u8ba4\u8bc6\u754c\u9762"},{"location":"chapter0/#_1","text":"","title":"\u5e8f\uff1a\u8ba4\u8bc6\u754c\u9762"},{"location":"chapter0/#_2","text":"\u5728\u767b\u5f55\u6216\u6ce8\u518c\u540e\uff0c\u6211\u4eec\u4f1a\u8df3\u8f6c\u5230\u79c0\u7c73\u7684\u4e3b\u9875\uff08\u89c1\u4e0b\u56fe\uff09\u3002\u70b9\u51fb\u5de6\u4e0a\u65b9\u7684 \u6211\u7684\u79c0\u7c73 \uff0c\u8fdb\u5165\u4e2a\u4eba\u4e3b\u9875\u4ece\u800c\u7ee7\u7eed\u5176\u4ed6\u64cd\u4f5c","title":"\u79c0\u7c73\u4e3b\u9875"},{"location":"chapter1/","text":"\u7b2c\u4e00\u7ae0\uff1a\u7b2c\u4e00\u7bc7\u63a8\u9001 \u5728\u9ad8\u6821\u5404\u7ec4\u7ec7\u7684\u5ba3\u4f20\u90e8\u4e2d\uff0c\u6700\u5e38\u89c1\u7684\u63a8\u9001\u4efb\u52a1\u5c31\u662f\u5c06\u67d0\u7bc7\u6587\u7a3f\u6392\u7248\u6210\u4e00\u4efd\u5408\u683c\u7684\u63a8\u9001\uff0c\u8fd9\u5c31\u8d77\u7801\u9700\u8981\u638c\u63e1\u4ee5\u4e0b\u7684\u56db\u4e2a\u57fa\u672c\u6280\u80fd\uff1a \u6311\u9009\u6a21\u677f \uff1b \u6587\u5b57\u66ff\u6362\u4e0e\u8bbe\u7f6e\uff1b \u63d2\u5165\u56fe\u7247\uff1b \u8c03\u6574\u5e03\u5c40\uff1b \u5236\u4f5c\u63a8\u9001\u65f6\uff0c\u6211\u4eec\u4e00\u822c\u4f1a\u5957\u7528\u79c0\u7c73\u4e0a\u73b0\u6210\u7684\u6a21\u677f\u6765\u8fdb\u884c\u6392\u7248\uff0c\u4f46\u9762\u5bf9\u7eb7\u7e41\u590d\u6742\u7684\u6a21\u677f\uff0c\u6311\u5230\u4e00\u4e2a\u9002\u5408\u7684\u3001\u7f8e\u89c2\u7684\u662f\u4e00\u95e8\u5b66\u95ee\uff0c\u8fd9\u5c31\u662f\u7b2c\u4e00\u4e2a\u6280\u80fd\uff1b \u6311\u9009\u6a21\u677f \u63d2\u5165\u56fe\u7247 \u8c03\u6574\u5e03\u5c40 \u8c03\u6574\u5e03\u5c40","title":"\u7b2c\u4e00\u7ae0\uff1a\u7b2c\u4e00\u7bc7\u63a8\u9001"},{"location":"chapter1/#_1","text":"\u5728\u9ad8\u6821\u5404\u7ec4\u7ec7\u7684\u5ba3\u4f20\u90e8\u4e2d\uff0c\u6700\u5e38\u89c1\u7684\u63a8\u9001\u4efb\u52a1\u5c31\u662f\u5c06\u67d0\u7bc7\u6587\u7a3f\u6392\u7248\u6210\u4e00\u4efd\u5408\u683c\u7684\u63a8\u9001\uff0c\u8fd9\u5c31\u8d77\u7801\u9700\u8981\u638c\u63e1\u4ee5\u4e0b\u7684\u56db\u4e2a\u57fa\u672c\u6280\u80fd\uff1a \u6311\u9009\u6a21\u677f \uff1b \u6587\u5b57\u66ff\u6362\u4e0e\u8bbe\u7f6e\uff1b \u63d2\u5165\u56fe\u7247\uff1b \u8c03\u6574\u5e03\u5c40\uff1b \u5236\u4f5c\u63a8\u9001\u65f6\uff0c\u6211\u4eec\u4e00\u822c\u4f1a\u5957\u7528\u79c0\u7c73\u4e0a\u73b0\u6210\u7684\u6a21\u677f\u6765\u8fdb\u884c\u6392\u7248\uff0c\u4f46\u9762\u5bf9\u7eb7\u7e41\u590d\u6742\u7684\u6a21\u677f\uff0c\u6311\u5230\u4e00\u4e2a\u9002\u5408\u7684\u3001\u7f8e\u89c2\u7684\u662f\u4e00\u95e8\u5b66\u95ee\uff0c\u8fd9\u5c31\u662f\u7b2c\u4e00\u4e2a\u6280\u80fd\uff1b","title":"\u7b2c\u4e00\u7ae0\uff1a\u7b2c\u4e00\u7bc7\u63a8\u9001"},{"location":"chapter1/#_2","text":"","title":"\u6311\u9009\u6a21\u677f"},{"location":"chapter1/#_3","text":"","title":"\u63d2\u5165\u56fe\u7247"},{"location":"chapter1/#_4","text":"","title":"\u8c03\u6574\u5e03\u5c40"},{"location":"chapter1/#_5","text":"","title":"\u8c03\u6574\u5e03\u5c40"},{"location":"chapter2/","text":"\u6587\u5b57\u8bbe\u7f6e \u7c98\u8d34\u65f6\u6e05\u9664\u683c\u5f0f","title":"\u7b2c\u4e8c\u7ae0\uff1a\u6587\u5b57\u8bbe\u7f6e"},{"location":"chapter2/#_1","text":"","title":"\u6587\u5b57\u8bbe\u7f6e"},{"location":"chapter2/#_2","text":"","title":"\u7c98\u8d34\u65f6\u6e05\u9664\u683c\u5f0f"},{"location":"chapter3/","text":"","title":"\u7b2c\u4e09\u7ae0\uff1a\u5e03\u5c40"}]}